{
  "name": "material-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "个人项目管理器 M0：扫描索引真实素材、中文搜索、浏览器预览与播放（本地优先，后续用 Electron 打包）",
  "scripts": {
    "scan": "node --no-warnings core/cli.ts scan",
    "stats": "node --no-warnings core/cli.ts stats",
    "search": "node --no-warnings core/cli.ts search",
    "serve": "node --no-warnings server/server.ts",
    "start": "npm run web:build && npm run serve",
    "web:build": "vite build",
    "web:dev": "vite",
    "typecheck": "tsc --noEmit",
    "pm": "node --no-warnings tools/pm.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.48.0"
  },
  "license": "MIT"
}
